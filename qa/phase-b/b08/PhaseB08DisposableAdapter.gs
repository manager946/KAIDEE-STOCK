/**
 * KAIDEE-STOCK Phase B08 — DISPOSABLE QA ONLY. NEVER DEPLOY. NEVER COPY TO
 * STAGING, PRODUCTION, OR THE B07 QA PROJECT.
 *
 * Bundle (generated by scripts/b08-qa-bundle.js, never hand-assembled):
 *   Code.gs (hooked QA copy) + this file + B08_DisposableQA_QA_ONLY.gs +
 *   B08_BundleIdentity.gs + appsscript.json. SalesStaging.gs,
 *   StagingDiagnostics.gs and Index.html are deliberately excluded.
 *
 * Two-sided runtime binding (all checks fail closed, before any read/write):
 *   project -> sheet : KAIDEE_B08_TARGET_ID + KAIDEE_B08_TARGET_SHA256
 *   sheet -> project : คลังสินค้า!A2 = 'B08-BIND|<RUN>|<sha256(scriptId)>'
 *   project identity : sha256(ScriptApp.getScriptId()) === KAIDEE_B08_SCRIPT_SHA256
 *   denylist         : KAIDEE_B08_DENYLIST_SHA256 = >=4 SHA-256 hex values of
 *                      protected spreadsheet IDs and script IDs (STAGING,
 *                      Production, synthetic QA STEP8-15, B07 QA project).
 * Real IDs are owner-private Script Properties; never commit them.
 */
const B08 = Object.freeze({
  titlePrefix: 'KAIDEE-STOCK-DISPOSABLE-QA-B08-',
  sentinelPrefix: 'KAIDEE-STOCK DISPOSABLE QA B08 — NO REAL DATA — ',
  bindPrefix: 'B08-BIND|',
  protectedTitles: ['KAIDEE-STOCK-SYNTHETIC-QA-STEP8-15'],
  tabs: ['คลังสินค้า', 'บันทึกรับ-จ่าย', 'ใบเบิกสินค้า', 'รายการใบเบิก'],
  minDenylist: 4,
  scenarios: ['PC', 'LOCK', 'PROP', 'RESTORE'],
  config: ['KAIDEE_B08_TARGET_ID', 'KAIDEE_B08_TARGET_SHA256', 'KAIDEE_B08_SCRIPT_SHA256',
    'KAIDEE_B08_RUN_ID', 'KAIDEE_B08_DENYLIST_SHA256', 'KAIDEE_B08_ROLE', 'KAIDEE_B08_RESTORE_SEQ']
});

function b08Stop_(why) { throw new Error('PHASEB08_STOP: ' + why); }
function b08Sha256Hex_(text) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text),
    Utilities.Charset.UTF_8).map(b => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}
function b08Escape_(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

/** Pure: validates project config and property-key allowlist. Returns parsed config. */
function b08ValidateConfig_(all) {
  const get = k => String(all[k] == null ? '' : all[k]);
  const run = get('KAIDEE_B08_RUN_ID');
  if (!/^[A-Z0-9]{6,12}$/.test(run)) b08Stop_('missing/invalid RUN_ID');
  const id = get('KAIDEE_B08_TARGET_ID');
  if (!/^[A-Za-z0-9_-]{20,}$/.test(id)) b08Stop_('missing/invalid TARGET_ID');
  const hex = /^[0-9a-f]{64}$/;
  const targetSha = get('KAIDEE_B08_TARGET_SHA256'), scriptSha = get('KAIDEE_B08_SCRIPT_SHA256');
  if (!hex.test(targetSha) || !hex.test(scriptSha)) b08Stop_('missing/invalid identity hash');
  const deny = get('KAIDEE_B08_DENYLIST_SHA256').split(',').map(s => s.trim()).filter(Boolean);
  if (deny.length < B08.minDenylist || deny.some(h => !hex.test(h)) || new Set(deny).size !== deny.length)
    b08Stop_('denylist must hold >=' + B08.minDenylist + ' distinct SHA-256 values');
  if (deny.indexOf(targetSha) >= 0 || deny.indexOf(scriptSha) >= 0) b08Stop_('configured identity is denylisted');
  const role = get('KAIDEE_B08_ROLE');
  if (['TEST', 'RESTORE'].indexOf(role) < 0) b08Stop_('ROLE must be TEST or RESTORE');
  const seq = get('KAIDEE_B08_RESTORE_SEQ');
  if (role === 'RESTORE' ? !/^[1-9]$/.test(seq) : seq !== '') b08Stop_('RESTORE_SEQ mismatch for role');
  const intentRe = new RegExp('^REQ_ISSUE_V1_QA-DISP-' + run + '-(' + B08.scenarios.join('|') + ')-\\d{3}$');
  Object.keys(all).forEach(k => {
    if (B08.config.indexOf(k) >= 0 || /^PHASEB08_[A-Z0-9_]+$/.test(k) || intentRe.test(k)) return;
    b08Stop_('unexpected Script Property key (wrong project?)');
  });
  return {run, id, targetSha, scriptSha, deny, role, seq,
    title: B08.titlePrefix + run + (role === 'RESTORE' ? '-R' + seq : '')};
}

/** Runtime identity: project, target and two-sided binding. Zero writes. */
function b08Identity_() {
  const props = PropertiesService.getScriptProperties();
  const cfg = b08ValidateConfig_(props.getProperties());
  const scriptSha = b08Sha256Hex_(ScriptApp.getScriptId());
  if (cfg.deny.indexOf(scriptSha) >= 0) b08Stop_('running inside a denylisted project');
  if (scriptSha !== cfg.scriptSha) b08Stop_('project identity mismatch');
  const idSha = b08Sha256Hex_(cfg.id);
  if (cfg.deny.indexOf(idSha) >= 0) b08Stop_('target spreadsheet is denylisted');
  if (idSha !== cfg.targetSha) b08Stop_('target spreadsheet hash mismatch');
  if (ScriptApp.getProjectTriggers().length !== 0) b08Stop_('project triggers must be zero');
  return Object.freeze({run: cfg.run, id: cfg.id, title: cfg.title, role: cfg.role,
    scriptSha, targetSha: idSha});
}

/** Replaces stagingDb_ ONLY in the disposable bundle; Code.gs ss_() routes here. */
/**
 * The ONLY Spreadsheet source in every B08 bundle (F-9). Identity-level checks that do not
 * need any seeded content: project identity, target ID/hash, denylist, triggers, opened ID
 * and title metadata. Used by the post-seed stagingDb_() and by the pre-seed guard.
 */
function b08OpenTarget_() {
  const who = b08Identity_();
  const ss = SpreadsheetApp.openById(who.id);
  if (ss.getId() !== who.id) b08Stop_('opened spreadsheet ID mismatch');
  const name = ss.getName();
  if (B08.protectedTitles.indexOf(name) >= 0 || name !== who.title) b08Stop_('spreadsheet title mismatch');
  return {ss, who};
}

/** Execution-local flag; only b08WithSeedReadback_ (called by the seeder) raises it. Not editor-callable. */
const B08_SEED_READBACK = {depth: 0};

/**
 * F-13 seed-completion gate for EVERY business mutation. Runs (a) as the first statement of
 * withLock_ in the QA copy of Code.gs (no exemption) and (b) inside stagingDb_() before any
 * spreadsheet object is returned. Business access requires: RUNNER bundle identity, seeder
 * absent and seed state COMPLETED. The only exemption is the seeder's own read-back
 * (opts.allowSeedReadback, stagingDb_ only): SEED identity, seeder installed, state STARTED,
 * and the caller receives a read-only proxy. withLock_ never passes allowSeedReadback, so no
 * locked business workflow (setReqStatus, saveReq, ...) can run during a seed read-back.
 */
function b08BusinessGate_(opts) {
  const who = b08Identity_();
  const kind = typeof B08_BUNDLE_IDENTITY === 'object' && B08_BUNDLE_IDENTITY ? B08_BUNDLE_IDENTITY.bundleKind : null;
  const seederInstalled = typeof phaseB08SeedDisposableOnce !== 'undefined' || typeof b08SeedLayout_ !== 'undefined';
  if (opts && opts.allowSeedReadback && B08_SEED_READBACK.depth > 0) {
    const state = PropertiesService.getScriptProperties().getProperty('PHASEB08_SEED_STATE');
    if (kind !== 'SEED' || !seederInstalled || state !== 'STARTED') b08Stop_('seed read-back not permitted (kind/seeder/state)');
    return 'SEED_READBACK';
  }
  if (kind !== 'RUNNER') b08Stop_('business mutation blocked: bundle identity is ' + (kind || 'missing') + ', not RUNNER');
  if (seederInstalled) b08Stop_('business mutation blocked: seeder still installed');
  try { b08SeedStateGuard_(who.run); } catch (e) { b08Stop_('business mutation blocked: ' + String(e.message).replace('PHASEB08_STOP: ', '')); }
  return 'RUNNER';
}

/** Seeder-only: run fn as a read-only seed read-back (SEED identity, seeder installed, state STARTED). */
function b08WithSeedReadback_(fn) {
  const kind = typeof B08_BUNDLE_IDENTITY === 'object' && B08_BUNDLE_IDENTITY ? B08_BUNDLE_IDENTITY.bundleKind : null;
  if (kind !== 'SEED' || typeof phaseB08SeedDisposableOnce === 'undefined' ||
      PropertiesService.getScriptProperties().getProperty('PHASEB08_SEED_STATE') !== 'STARTED')
    b08Stop_('seed read-back not permitted (kind/seeder/state)');
  B08_SEED_READBACK.depth++;
  try { return fn(); } finally { B08_SEED_READBACK.depth--; }
}

/**
 * F-15: explicit per-kind ALLOWLIST for the seed read-back facade. Anything not listed STOPs
 * by default (no prefix blacklist). 'Sheet'/'Range'/'Sheet[]' entries return a new facade, never
 * a raw Google object; 'value' entries must return plain data (primitives, Dates, arrays of them).
 */
const B08_READONLY_ALLOW = Object.freeze({
  Spreadsheet: Object.freeze({getSheetByName: 'Sheet', getSheets: 'Sheet[]', getName: 'value', getId: 'value'}),
  Sheet: Object.freeze({getRange: 'Range', getLastRow: 'value', getLastColumn: 'value', getName: 'value'}),
  Range: Object.freeze({getValues: 'value', getDisplayValues: 'value', getFormulas: 'value', getFormula: 'value',
    getValue: 'value', getDisplayValue: 'value'})
});

/** Read-only facade (default deny). The raw object is captured in a closure, never exposed. */
function b08ReadOnly_(raw, kind) {
  kind = kind || 'Spreadsheet';
  const allow = B08_READONLY_ALLOW[kind];
  if (!allow || raw === null || typeof raw !== 'object') b08Stop_('read-only seed read-back: invalid ' + kind);
  const plain = v => v === null || typeof v !== 'object' || Object.prototype.toString.call(v) === '[object Date]' ||
    (Array.isArray(v) && v.every(plain));
  const deny = what => () => b08Stop_('read-only seed read-back: ' + kind + '.' + what + ' not allowed');
  return new Proxy(Object.freeze(Object.create(null)), {
    get(_t, key) {
      if (typeof key !== 'string') return undefined;
      const ret = Object.prototype.hasOwnProperty.call(allow, key) ? allow[key] : null;
      if (!ret) return deny(key);
      return (...args) => {
        const out = raw[key].apply(raw, args);
        if (ret === 'value') {
          if (!plain(out)) b08Stop_('read-only seed read-back: ' + kind + '.' + key + ' returned an object');
          return out;
        }
        if (ret === 'Sheet[]') return out.map(x => b08ReadOnly_(x, 'Sheet'));
        return out === null ? null : b08ReadOnly_(out, ret);
      };
    },
    set(_t, key) { return deny('set ' + String(key))(); },
    defineProperty(_t, key) { return deny('define ' + String(key))(); },
    deleteProperty(_t, key) { return deny('delete ' + String(key))(); },
    has() { return false; },
    ownKeys() { return []; },
    getPrototypeOf() { return null; },
    setPrototypeOf() { return deny('setPrototypeOf')(); }
  });
}

/** Post-seed guard (unchanged strictness): b08OpenTarget_ + seed gate + tabs, sentinel, binding, 52 SKUs. */
function stagingDb_() {
  const t = b08OpenTarget_(), ss = t.ss, who = t.who;
  const mode = b08BusinessGate_({allowSeedReadback: true});
  const tabs = ss.getSheets().map(s => s.getName()).sort();
  if (JSON.stringify(tabs) !== JSON.stringify(B08.tabs.slice().sort())) b08Stop_('unexpected tabs');
  const inv = ss.getSheetByName('คลังสินค้า');
  const head = inv.getRange(1, 1, 2, 1).getDisplayValues();
  if (head[0][0] !== B08.sentinelPrefix + who.run) b08Stop_('missing disposable sentinel');
  if (head[1][0] !== B08.bindPrefix + who.run + '|' + who.scriptSha) b08Stop_('sheet->project binding mismatch');
  const codes = inv.getRange(8, 1, 52, 1).getDisplayValues().map(r => r[0]);
  if (!codes.every((c, i) => c === 'QA-' + ('000' + (i + 1)).slice(-3))) b08Stop_('unexpected SKU identity');
  if (inv.getRange(60, 1).getDisplayValue() !== '') b08Stop_('unexpected SKU beyond row 59');
  return mode === 'SEED_READBACK' ? b08ReadOnly_(ss) : ss;
}

/** Disposable fixture: request key -> ordered [SKU, qty] lines. Every request must exist with exactly these lines. */
const B08_FIXTURE = Object.freeze({
  'PC-001': [['QA-010', 2], ['QA-011', 3]],
  'LOCK-001': [['QA-020', 1]],
  'LOCK-002': [['QA-021', 1]],
  'PROP-001': [['QA-030', 1]],
  'PROP-002': [['QA-031', 1]],
  'RESTORE-001': [['QA-040', 2]],
  'RESTORE-002': [['QA-041', 1]]
});
const b08Blank_ = row => row.every(x => x === '' || x == null);

/** Header rows written by the seeder and checked by post-seed readiness (F-11). Labels are synthetic. */
const B08_HEADERS = Object.freeze({
  inv: ['รหัส/รุ่นสินค้า', 'ชื่อสินค้า (synthetic)', 'รายละเอียด (synthetic)', 'หน่วย (synthetic)', 'ราคา',
    'ยอดยกมา', 'รับเข้า', 'จ่ายออก', 'คงเหลือ', 'จุดเตือนเหลือน้อย'],
  mv: ['วันที่', 'ประเภท', 'รหัส/รุ่นสินค้า', 'รายละเอียด', 'จำนวน', 'หน่วย', 'ราคา/หน่วย', 'มูลค่า', 'ผู้บันทึก',
    'หมายเหตุ', 'MovementID', 'บันทึกเมื่อ', 'บันทึกโดย', 'DocumentNo'],
  rq: ['ReqID', 'เลขที่', 'วันที่', 'ผู้ขอ', 'แผนก', 'เหตุผล', 'สถานะ', 'ผู้อนุมัติ', 'ผู้จ่าย', 'วันที่จ่าย', 'ผู้สร้าง'],
  ln: ['LineID', 'ReqID', 'รหัส/รุ่นสินค้า', 'จำนวน', 'หมายเหตุ']
});

/**
 * Seed state machine (F-11): absent = NOT_STARTED -> STARTED -> COMPLETED, or REVIEW_REQUIRED.
 * Runners require COMPLETED + a matching PHASEB08_SEED_DONE. Nothing ever resets these keys.
 * The recorded baseline hash is evidence only; it is never compared after tests mutate data.
 */
function b08SeedStateGuard_(run) {
  const props = PropertiesService.getScriptProperties();
  const state = props.getProperty('PHASEB08_SEED_STATE'), raw = props.getProperty('PHASEB08_SEED_DONE');
  if (props.getProperty('PHASEB08_SEED_ERROR') !== null) b08Stop_('seed error recorded; REVIEW_REQUIRED');
  if (state !== 'COMPLETED') b08Stop_('seed state is ' + (state || 'NOT_STARTED') + ', not COMPLETED');
  let done;
  try { done = JSON.parse(raw); } catch (_e) { b08Stop_('PHASEB08_SEED_DONE missing or unreadable'); }
  if (!done || done.run !== run || !/^[0-9a-f]{64}$/.test(String(done.baselineSha256)) ||
      done.headers !== 7 || done.lines !== 8 || done.skus !== 52) b08Stop_('PHASEB08_SEED_DONE does not match this run/fixture');
  return done;
}

/**
 * Relationship-level fixture guard (F-5). Reads RAW sheet rows (not the filtered
 * readReqs_/readMv_ views) and proves header <-> line <-> movement <-> intent
 * integrity. Any orphan, unknown, duplicate or malformed record STOPs. Zero writes.
 * opts.allowMissingIntent is used ONLY by the RB-5 negative drill.
 */
function b08FixtureGuard_(run, opts) {
  const allowMissingIntent = !!(opts && opts.allowMissingIntent);
  // opts.seeding is passed ONLY by the seeder's own post-write verification (statically enforced).
  if (!(opts && opts.seeding)) {
    if (typeof phaseB08SeedDisposableOnce !== 'undefined' || typeof b08SeedLayout_ !== 'undefined')
      b08Stop_('seeder still installed: delete B08_Seeder_QA_ONLY.gs and install the RUNNER bundle identity');
    b08SeedStateGuard_(run);
  }
  const P = 'QA-DISP-' + run + '-';
  const keyOf = id => id.indexOf(P) === 0 ? id.slice(P.length) : null;
  const rqSh = sh_(SH.rq), lnSh = sh_(SH.ln);
  const rqRows = rqSh.getLastRow() > 1 ? rqSh.getRange(2, 1, rqSh.getLastRow() - 1, 11).getValues() : [];
  const lnRows = lnSh.getLastRow() > 1 ? lnSh.getRange(2, 1, lnSh.getLastRow() - 1, 5).getValues() : [];
  // 1. Headers: exact fixture set, valid identity, no duplicates, no ID-less content.
  const heads = {};
  rqRows.forEach((v, i) => {
    if (b08Blank_(v)) return;
    const id = String(v[0] || ''), key = keyOf(id);
    if (!id || !key || !Object.prototype.hasOwnProperty.call(B08_FIXTURE, key)) b08Stop_('unknown or ID-less requisition header at row ' + (i + 2));
    if (heads[id]) b08Stop_('duplicate requisition ID ' + id);
    if (String(v[1]) !== P + 'RQ-' + key) b08Stop_('requisition document number mismatch ' + id);
    if (['อนุมัติ', 'จ่ายแล้ว'].indexOf(v[6]) < 0) b08Stop_('unexpected requisition status ' + id);
    heads[id] = {id, key, no: String(v[1]), status: v[6], lines: []};
  });
  Object.keys(B08_FIXTURE).forEach(k => { if (!heads[P + k]) b08Stop_('missing fixture requisition ' + k); });
  // 2. Lines: every line references an existing header; IDs unique and ordered; payload = fixture.
  const lineIds = {};
  lnRows.forEach((v, i) => {
    if (b08Blank_(v)) return;
    const lid = String(v[0] || ''), rid = String(v[1] || '');
    if (!lid || !rid) b08Stop_('line without LineID/RequestID at row ' + (i + 2));
    if (lineIds[lid]) b08Stop_('duplicate LineID ' + lid);
    lineIds[lid] = true;
    const h = heads[rid];
    if (!h) b08Stop_('orphan line ' + lid + ' references unknown requisition');
    if (lid !== rid + '-L' + (h.lines.length + 1)) b08Stop_('line ID/order mismatch ' + lid);
    h.lines.push({id: lid, code: String(v[2] || ''), qty: v[3]});
  });
  Object.keys(heads).forEach(id => {
    const h = heads[id], want = B08_FIXTURE[h.key];
    if (h.lines.length !== want.length ||
        h.lines.some((l, i) => l.code !== want[i][0] || l.qty !== want[i][1])) b08Stop_('line payload mismatch ' + id);
  });
  // 3. Movements: each references an existing header AND line (index/code/qty/doc); no duplicates.
  const moves = {}, ids = {};
  reqIssueRows_().forEach(({v, row}) => {
    if (b08Blank_(v.filter((_, c) => [3, 5, 7].indexOf(c) < 0))) return; // formula-only columns D/F/H
    const id = String(v[10] || ''), m = /^REQ-(.+)-(\d+)$/.exec(id);
    if (!m) b08Stop_('unidentified ledger row ' + row);
    if (ids[id]) b08Stop_('duplicate MovementID ' + id);
    ids[id] = true;
    const h = heads[m[1]], n = Number(m[2]);
    if (!h) b08Stop_('movement ' + id + ' references unknown requisition');
    const line = h.lines[n - 1];
    if (!line || String(n) !== m[2]) b08Stop_('movement ' + id + ' references unknown line');
    if (String(v[13] || '') !== h.no || String(v[2]) !== line.code || v[4] !== line.qty || ['', 'จ่ายออก'].indexOf(v[1]) < 0)
      b08Stop_('movement ' + id + ' does not match its header/line');
    (moves[h.id] = moves[h.id] || []).push({id, n, type: v[1]});
  });
  // 4. Intents: no intent without header; header with movements needs a matching intent; paid = complete.
  const props = PropertiesService.getScriptProperties().getProperties();
  Object.keys(props).filter(k => k.indexOf('REQ_ISSUE_V1_') === 0).forEach(k => {
    const h = heads[k.slice('REQ_ISSUE_V1_'.length)];
    if (!h) b08Stop_('intent without requisition ' + k);
    let plan;
    try { plan = JSON.parse(props[k]); } catch (_e) { b08Stop_('unparsable intent ' + k); }
    if (plan.version !== 1 || plan.doc !== h.no || !Array.isArray(plan.shape) || plan.shape.length !== h.lines.length ||
        plan.shape.some((s, i) => s.id !== 'REQ-' + h.id + '-' + (i + 1) || s.line !== h.lines[i].id ||
          s.code !== h.lines[i].code || s.qty !== h.lines[i].qty)) b08Stop_('intent does not match header/lines ' + k);
  });
  Object.keys(heads).forEach(id => {
    const h = heads[id], mv = moves[id] || [], intent = props['REQ_ISSUE_V1_' + id];
    if ((mv.length || h.status === 'จ่ายแล้ว') && !intent && !allowMissingIntent) b08Stop_('ledger/paid state without intent ' + id);
    if (h.status === 'จ่ายแล้ว' && (mv.length !== h.lines.length || mv.some(x => x.type !== 'จ่ายออก')))
      b08Stop_('paid requisition with incomplete ledger ' + id);
  });
  const audit = stockFormulaAudit_();
  if (!audit.safeForNewRequisitionIssue || audit.checkedSkuCount !== 52) b08Stop_('formula audit not safe');
  const rec = b08Reconcile52_();
  if (rec.mismatches.length) b08Stop_('52-SKU reconciliation failed: ' + rec.mismatches.slice(0, 3).join('; '));
  return {reqs: Object.keys(heads).map(id => ({id, status: heads[id].status})),
    headerCount: Object.keys(heads).length,
    lineCount: Object.keys(heads).reduce((n, id) => n + heads[id].lines.length, 0),
    intentCount: Object.keys(props).filter(k => k.indexOf('REQ_ISSUE_V1_') === 0).length,
    moveCount: Object.keys(ids).length, formula: audit.status, reconciliation: rec};
}

/**
 * Fresh-fixture assertion shared by the seeder verification and post-seed readiness (F-11):
 * 4 tabs + headers, 7 approved headers, 8 lines, 52 SKUs, F/G/H/I reconciled, 0 movements,
 * 0 intents. Only valid immediately after seeding — never used after tests change data.
 */
function b08AssertFreshFixture_(g) {
  const ss = stagingDb_();
  const row = (tab, r, n) => ss.getSheetByName(tab).getRange(r, 1, 1, n).getDisplayValues()[0];
  const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
  if (!same(row('คลังสินค้า', 7, 10), B08_HEADERS.inv)) b08Stop_('inventory header row 7 mismatch');
  if (!same(row('บันทึกรับ-จ่าย', 3, 14), B08_HEADERS.mv)) b08Stop_('ledger header row 3 mismatch');
  if (!same(row('ใบเบิกสินค้า', 1, 11), B08_HEADERS.rq)) b08Stop_('requisition header row mismatch');
  if (!same(row('รายการใบเบิก', 1, 5), B08_HEADERS.ln)) b08Stop_('line header row mismatch');
  if (g.headerCount !== 7 || g.lineCount !== 8) b08Stop_('fixture must have 7 headers and 8 lines');
  if (g.reqs.some(r => r.status !== 'อนุมัติ')) b08Stop_('fresh fixture requests must all be approved');
  if (g.moveCount !== 0 || g.intentCount !== 0) b08Stop_('fresh fixture must have 0 movements and 0 intents');
  if (g.reconciliation.checked !== 52 || g.reconciliation.totalIssued !== 0 || g.reconciliation.mismatches.length)
    b08Stop_('fresh fixture reconciliation must be 52/52 with zero issues');
  return {headers: 7, lines: 8, skus: 52, movements: 0, intents: 0};
}

/**
 * Approved synthetic inventory schema (docs/STEP8_15_SYNTHETIC_GOOGLE_SHEETS_INTEGRATION_PLAN_20261029_TH.md):
 *   F(r) = 100 constant opening (no formula)
 *   G(r) = SUMIFS(receipts "รับเข้า")      H(r) = SUMIFS(issues "จ่ายออก")      I(r) = F(r)+G(r)-H(r)
 */
const B08_INV = Object.freeze({opening: 100});
function b08InvFormula_(col, row) {
  if (col === 'I') return '=F' + row + '+G' + row + '-H' + row;
  return "=SUMIFS('บันทึกรับ-จ่าย'!$E:$E,'บันทึกรับ-จ่าย'!$C:$C,A" + row +
    ",'บันทึกรับ-จ่าย'!$B:$B,\"" + (col === 'G' ? 'รับเข้า' : 'จ่ายออก') + '")';
}

/**
 * F-6 + F-8: 52-SKU inventory reconciliation on CALCULATED values. For every row:
 *   F is the constant opening 100; G/H/I carry the approved formula text; the
 *   calculated G/H equal the ledger receipt/issue sums; I equals F+G-H and balances_().
 * A formula whose text is intact but whose value drifts is a mismatch. Non-throwing
 * report; b08FixtureGuard_ STOPs on any mismatch.
 */
function b08Reconcile52_() {
  const inv = sh_(SH.inv), rg = inv.getRange(8, 1, 52, 10), rows = rg.getValues(), fx = rg.getFormulas();
  const mv = readMv_(), issued = {}, received = {}, mismatches = [];
  if (mv.some(m => m.type !== 'จ่ายออก')) mismatches.push('non-issue movement present');
  mv.forEach(m => {
    const into = m.type === 'จ่ายออก' ? issued : m.type === 'รับเข้า' ? received : null;
    if (into) into[m.code] = (into[m.code] || 0) + m.qty;
  });
  const bal = balances_(readItems_(), mv);
  const num = x => typeof x === 'number' && isFinite(x);
  let total = 0;
  rows.forEach((v, i) => {
    const row = 8 + i, code = String(v[0]), F = v[5], G = v[6], Hv = v[7], I = v[8];
    if (fx[i][5] || F !== B08_INV.opening) mismatches.push('F opening drift row ' + row + ' ' + code + ' sheet=' + (fx[i][5] || F) + ' expected=' + B08_INV.opening);
    ['G', 'H', 'I'].forEach((col, k) => {
      if (stockFormulaSyntax_(fx[i][6 + k]) !== stockFormulaSyntax_(b08InvFormula_(col, row)))
        mismatches.push(col + ' formula drift row ' + row + ' ' + code);
    });
    if (!num(G) || !num(Hv) || !num(I)) { mismatches.push('row ' + row + ' G/H/I not numeric'); return; }
    if (G !== (received[code] || 0)) mismatches.push('G value drift row ' + row + ' ' + code + ' sheet=' + G + ' ledger=' + (received[code] || 0));
    if (Hv !== (issued[code] || 0)) mismatches.push('H value drift row ' + row + ' ' + code + ' sheet=' + Hv + ' ledger=' + (issued[code] || 0));
    if (I !== F + G - Hv) mismatches.push('I value drift row ' + row + ' ' + code + ' sheet=' + I + ' F+G-H=' + (F + G - Hv));
    if (I !== bal[code]) mismatches.push('balance drift row ' + row + ' ' + code + ' sheet=' + I + ' ledger=' + bal[code]);
    total += Hv;
  });
  return {checked: rows.length, mismatches, totalIssued: total};
}
